# Copy to .env and fill in. .env is gitignored; never commit real credentials.
# Owner role: migrations and loaders.
DATABASE_URL=postgresql+psycopg://miq_owner:CHANGE_ME@localhost:5432/marketingiq
# Least-privilege role for analytics, REST and assistant tools.
DATABASE_URL_APP=postgresql+psycopg://miq_app:CHANGE_ME@localhost:5432/marketingiq
# Disposable database for integration tests (tests may drop and rebuild its schemas).
TEST_DATABASE_URL=postgresql+psycopg://miq_owner:CHANGE_ME@localhost:5432/marketingiq_test

# The assistant's language model: any OpenAI-compatible endpoint.
# Default: Google Gemini free tier. Get a key at https://aistudio.google.com/apikey (no card).
# The free tier may use prompts to improve Google's products: synthetic data only, never
# company data (docs/unverified-register.md, U-14).
LLM_API_KEY=
# LLM_MODEL=gemini-3.5-flash-lite
# Other providers, for example:
#   Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=<a model with tool use>
#   Ollama: LLM_BASE_URL=http://localhost:11434/v1        LLM_MODEL=qwen3:8b   (no key needed)
